# Trusted shell configuration for host cron; store as /etc/takeaway-backup.env, mode 600.
# No database passwords here: Compose reads the separate private deployment env file.
DEPLOY_ENV_FILE=/opt/takeaway/.env.deploy
COMPOSE_PROJECT=takeaway
BACKUP_DIR=/var/lib/takeaway/backups
BACKUP_REMOTE=takeaway-backup@backup.example.net:/srv/takeaway/backups
BACKUP_SSH_CONFIG=/etc/takeaway-backup.ssh
LOCAL_KEEP_DAYS=7
# On the OFF-HOST backup machine, configure a separate retention job for 30 days.
