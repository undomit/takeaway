# Copy to .env and replace the JWT placeholder before starting the application.
# Generate a secret with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PLATFORM_CURRENCY=EUR

# Generate distinct local passwords and use URL-safe values in these example URLs.
DB_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
DB_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_PASSWORD
DB_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
DATABASE_URL=postgresql+psycopg://takeaway_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/takeaway
MIGRATION_DATABASE_URL=postgresql+psycopg://takeaway_owner:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5432/takeaway
