# Copy to a private deployment env file; generate each value independently.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PLATFORM_CURRENCY=EUR
DB_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
DB_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_PASSWORD
DB_RUNTIME_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
# Use URL-safe password characters; Compose builds container URLs using hostname db.
APP_IMAGE=takeaway-app:local

# Production DNS hostname and canonical HTTPS origin; no trailing slash.
PUBLIC_HOST=orders.example.com
PUBLIC_ORIGIN=https://orders.example.com
# Host directory containing fullchain.pem and privkey.pem (mounted read-only).
TLS_CERT_DIR=./.certs
